@startuml SOBOTEC_UWE_ContentModel
!theme plain
skinparam classAttributeIconSize 0
skinparam classFontSize 11
skinparam packageFontSize 12
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 80
hide empty members

' ─────────────────────────────────────────
'  CLASE BASE ABSTRACTA
' ─────────────────────────────────────────
abstract class AuditModel {
  + created : DateTimeField
  + updated_at : DateTimeField
  + deleted_at : DateTimeField [0..1]
  + deleted_by : FK→Empleado [0..1]
  + activo : BooleanField = True
}

' ═══════════════════════════════════════════════════
'  PACKAGE: projects
' ═══════════════════════════════════════════════════
package "projects" #E8F4FD {

  class Cliente {
    + nit_ci : CharField
    + nombre : CharField
    + apellido_paterno : CharField
    + apellido_materno : CharField [opt]
    + rol_contacto : CharField
    + tipo_contratante : CharField
    + telefono : CharField
    + correo : EmailField [opt]
    + direccion : CharField
    + nombre_entidad : CharField [opt]
  }

  class Proyecto {
    + codigo : CharField [unique]
    + nombre : CharField [unique]
    + descripcion : TextField
    + estado_proyecto : CharField
    + tipo_proyecto : CharField
    + fecha_inicio : DateField [opt]
    + fecha_fin : DateField [opt]
    + observacion : TextField
    + monto_total : DecimalField
    + estado_pago : CharField
  }

  class AsignacionProyecto {
    + fecha_inicio_plan : DateField [opt]
    + fecha_fin_plan : DateField [opt]
    + dias_planificados : PositiveSmallIntegerField [opt]
    ' derivados
    + dias_reales : property
    + eficiencia_pct : property
    + dias_retraso : property
  }

  class ContratoProyecto {
    + fecha_firma : DateField
    + fecha_inicio : DateField
    + fecha_fin : DateField
    + monto_acordado : DecimalField
    + porcentaje_multa_diaria : DecimalField
    + porcentaje_multa_maxima : DecimalField
    + garantia_meses : PositiveSmallIntegerField
    + observaciones : TextField
    + documento : FileField [opt]
    ' derivados
    + dias_retraso : property
    + multa_acumulada : property
    + multa_tope_alcanzado : property
    + estado_multa : property
  }

  class HistorialPresupuesto {
    + fecha_modificacion : DateTimeField
    + monto_anterior : DecimalField
    + monto_actual : DecimalField
    + motivo_cambio : TextField
  }

  class HistorialEstadoProyecto {
    + estado_anterior : CharField
    + estado_nuevo : CharField
    + fecha : DateTimeField
    + motivo : TextField
  }

  class PlantillaTarea {
    + nombre : CharField
    + tipo : CharField
    + descripcion : TextField
  }

  class ItemPlantilla {
    + descripcion : CharField
    + orden : PositiveSmallIntegerField
  }

  class SubItemPlantilla {
    + descripcion : CharField
    + orden : PositiveSmallIntegerField
  }

  class Sede {
    + nombre : CharField
    + direccion : CharField
    + descripcion : TextField
    + latitud : DecimalField [opt]
    + longitud : DecimalField [opt]
    + estado : CharField
    ' derivado
    + porcentaje_checklist : property
  }

  class FotoSede {
    + foto : ImageField
    + descripcion : CharField
  }

  class TareaChecklist {
    + descripcion : CharField
    + orden : PositiveSmallIntegerField
    + completado : BooleanField
    + fecha_completado : DateTimeField [opt]
  }

  class SubtareaChecklist {
    + descripcion : CharField
    + orden : PositiveSmallIntegerField
    + completado : BooleanField
    + fecha_completado : DateTimeField [opt]
  }

  class PagoProyecto {
    + monto : DecimalField
    + descuento : DecimalField
    + motivo_descuento : CharField
    + fecha : DateField
    + tipo_pago : CharField
    + numero_referencia : CharField
    + estado : CharField
    ' derivado
    + monto_neto : property
  }

  class Notificacion {
    + tipo : CharField
    + mensaje : TextField
    + leida : BooleanField
    + fecha : DateTimeField
  }

  class Garantia {
    + fecha_inicio : DateField
    + fecha_vencimiento : DateField
    ' derivados
    + estado : property
    + dias_restantes : property
    + costo_total_incidencias : property
  }

  class IncidenciaGarantia {
    + descripcion : TextField
    + fecha_reporte : DateField
    + fecha_reparacion : DateField [opt]
    + costo_reparacion : DecimalField
    + estado : CharField
    + evidencia : FileField [opt]
  }
}

' ═══════════════════════════════════════════════════
'  PACKAGE: empleados
' ═══════════════════════════════════════════════════
package "empleados" #FEF9E7 {

  class Empleado {
    + username : CharField
    + nombre : CharField
    + apellido_paterno : CharField
    + apellido_materno : CharField [opt]
    + cargo : CharField
    + carnet_identidad : CharField [unique]
    + numero_celular : CharField [opt]
    + email : EmailField
  }

  class ContratoEmpleado {
    + tipo_contrato : CharField
    + dias_laborales : PositiveIntegerField = 28
    + fecha_firma : DateField
    + fecha_inicio : DateField
    + fecha_fin : DateField
    + monto_acordado : DecimalField
    + observaciones : TextField
    + documento : FileField [opt]
    ' derivado
    + monto_diario : property
  }

  class PagoEmpleado {
    + monto : DecimalField
    + fecha : DateField
    + tipo_pago : CharField
    + concepto : CharField
  }

  class JornadaEmpleado {
    + fecha : DateField
    + dias : DecimalField
    + observacion : TextField
    + estado : CharField
    + motivo_rechazo : TextField
    ' derivado
    + monto : property
  }
}

' ═══════════════════════════════════════════════════
'  PACKAGE: inventario
' ═══════════════════════════════════════════════════
package "inventario" #F9EBEA {

  class Proveedor {
    + nombre : CharField
    + rubro : CharField
    + nit : CharField
    + telefono : CharField
    + correo : EmailField
    + direccion : CharField
    + encargado_nombre : CharField
    + encargado_cargo : CharField
    + encargado_celular : CharField
  }

  class Insumo {
    + nombre : CharField
    + marca : CharField
    + modelo : CharField
    + categoria : CharField
    + unidad_medida : CharField
    + stock : IntegerField
    + stock_minimo : PositiveIntegerField
    + ultimo_precio_compra : DecimalField
    ' derivado
    + stock_status : property
  }

  class Compra {
    + cantidad : PositiveIntegerField
    + costo_unitario : DecimalField
    + fecha : DateField
    + numero_factura : CharField
    ' derivado
    + costo_total : property
  }

  class Requiere {
    + cantidad : PositiveIntegerField
    + durante_garantia : BooleanField
    ' derivado
    + costo_total : property
  }

  class RequiereLote {
    + cantidad : PositiveIntegerField
  }
}

' ─────────────────────────────────────────
'  HERENCIA DE AuditModel
' ─────────────────────────────────────────
AuditModel <|-- Cliente
AuditModel <|-- Proyecto
AuditModel <|-- AsignacionProyecto
AuditModel <|-- ContratoProyecto
AuditModel <|-- PlantillaTarea
AuditModel <|-- Sede
AuditModel <|-- FotoSede
AuditModel <|-- TareaChecklist
AuditModel <|-- SubtareaChecklist
AuditModel <|-- PagoProyecto
AuditModel <|-- Garantia
AuditModel <|-- IncidenciaGarantia
AuditModel <|-- ContratoEmpleado
AuditModel <|-- PagoEmpleado
AuditModel <|-- JornadaEmpleado
AuditModel <|-- Proveedor
AuditModel <|-- Insumo
AuditModel <|-- Compra
AuditModel <|-- Requiere
AuditModel <|-- RequiereLote

' ─────────────────────────────────────────
'  RELACIONES — projects
' ─────────────────────────────────────────
Cliente "1" --> "0..*" Proyecto : contrata >

Proyecto "1" --> "0..*" Sede : tiene >
Proyecto "1" --> "0..*" ContratoProyecto : formaliza >
Proyecto "1" --> "0..*" PagoProyecto : recibe >
Proyecto "1" --> "0..*" HistorialPresupuesto : registra >
Proyecto "1" --> "0..*" HistorialEstadoProyecto : rastrea >
Proyecto "0..*" -- "0..*" Empleado : equipo >
Proyecto "1" --> "0..*" AsignacionProyecto : planifica >

AsignacionProyecto "0..*" --> "1" Empleado : asigna a >

ContratoProyecto "1" --> "0..1" Garantia : genera >

PlantillaTarea "1" --> "0..*" ItemPlantilla : contiene >
ItemPlantilla "1" --> "0..*" SubItemPlantilla : detalla >

Sede "0..*" --> "0..1" PlantillaTarea : aplica >
Sede "1" --> "0..*" TareaChecklist : lista >
Sede "1" --> "0..*" FotoSede : documenta >

TareaChecklist "1" --> "0..*" SubtareaChecklist : subdivide >
TareaChecklist "0..*" -- "0..*" Empleado : participa >

Garantia "1" --> "0..*" IncidenciaGarantia : registra >

Notificacion "0..*" --> "1" Empleado : destina a >
Notificacion "0..*" --> "0..1" Proyecto : sobre >
Notificacion "0..*" --> "0..1" Sede : sobre >

HistorialPresupuesto "0..*" --> "1" Empleado : modificado_por >
HistorialEstadoProyecto "0..*" --> "1" Empleado : cambiado_por >

FotoSede "0..*" --> "1" Empleado : subida_por >
TareaChecklist "0..*" --> "0..1" Empleado : completado_por >
SubtareaChecklist "0..*" --> "0..1" Empleado : completado_por >
IncidenciaGarantia "0..*" --> "0..1" Empleado : reparado_por >

' ─────────────────────────────────────────
'  RELACIONES — empleados
' ─────────────────────────────────────────
Empleado "1" --> "0..*" ContratoEmpleado : tiene >
ContratoEmpleado "1" --> "0..*" JornadaEmpleado : registra >
ContratoEmpleado "1" --> "0..*" PagoEmpleado : genera >
JornadaEmpleado "0..*" --> "1" Proyecto : en >
JornadaEmpleado "0..*" --> "0..1" PagoEmpleado : incluida_en >
JornadaEmpleado "0..*" --> "1" Empleado : registrado_por >

' ─────────────────────────────────────────
'  RELACIONES — inventario
' ─────────────────────────────────────────
Proveedor "1" --> "0..*" Compra : suministra >
Insumo "1" --> "0..*" Compra : comprado_como >
Insumo "1" --> "0..*" Requiere : requerido_en >
Proyecto "1" --> "0..*" Requiere : consume >
Requiere "1" --> "0..*" RequiereLote : trazado_por >
Compra "1" --> "0..*" RequiereLote : consume_de >

@enduml
