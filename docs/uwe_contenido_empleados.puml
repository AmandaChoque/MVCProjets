@startuml SOBOTEC_CM_Empleados
title Modelo de Contenido UWE — Módulo: Empleados (SOBOTEC S.R.L.)

left to right direction

skinparam classFontSize 10
skinparam classFontName Arial
skinparam classHeaderFontSize 11
skinparam classHeaderFontStyle bold
skinparam arrowColor #000000
skinparam arrowFontSize 9
skinparam nodesep 25
skinparam ranksep 35
skinparam padding 4
skinparam defaultTextAlignment left
skinparam shadowing false

skinparam class {
  BackgroundColor        #e1e1e1
  BorderColor            #000000
  HeaderBackgroundColor  #e1e1e1
  FontColor              #000000
  AttributeFontColor     #000000
}

' ─── EMPLEADO ───
class Empleado {
  nombre : String
  apellido_paterno : String
  apellido_materno : String
  cargo : String
  carnet_identidad : String
  numero_celular : String
  email : Email
  is_active : Boolean
  / activo : Boolean
  / get_full_name() : String
}

' ─── CONTRATO EMPLEADO ───
class ContratoEmpleado {
  fecha_firma : Date
  fecha_inicio : Date
  fecha_fin : Date
  dias_laborales : Integer
  monto_acordado : Decimal
  observaciones : Text
  documento : File
  / monto_diario : Decimal
  / vigente : Boolean
  / estado_contrato : String
  / dias_hasta_vencimiento : Integer
}

' ─── JORNADA EMPLEADO ───
class JornadaEmpleado {
  fecha : Date
  dias : Decimal
  estado : String
  observacion : Text
  motivo_rechazo : Text
  / monto : Decimal
}

' ─── PAGO EMPLEADO ───
class PagoEmpleado {
  monto : Decimal
  fecha : Date
  concepto : String
  estado : String
}

' ─── PROYECTO (referencia) ───
class Proyecto <<ref>> {
  codigo : String
  nombre : String
  estado_proyecto : String
}

' ═══════ RELACIONES ═══════
Empleado         "1"    --  "0..*" ContratoEmpleado  : tiene
ContratoEmpleado "1"    --  "0..*" JornadaEmpleado   : registra
ContratoEmpleado "1"    --  "0..*" PagoEmpleado      : genera

JornadaEmpleado  "0..*" --  "1"   Proyecto           : trabaja en
JornadaEmpleado  "0..*" --  "0..1" PagoEmpleado      : incluida en
JornadaEmpleado  "0..*" --  "1"   Empleado           : registrado por

note bottom of ContratoEmpleado
  UniqueConstraint:
  un contrato activo
  por empleado
end note

note bottom of JornadaEmpleado
  dias: 0.5 (medio día) ó 1.0 (día completo)
  estado: pendiente / aprobada / rechazada
  concepto PagoEmpleado: pago_jornada / adelanto / liquidacion
end note

note "/ atributo derivado (calculado)" as N1

@enduml
