@startuml SOBOTEC_CM_Proyectos
title Modelo de Contenido UWE — Módulo: Proyectos (SOBOTEC S.R.L.)

left to right direction

skinparam classFontSize 10
skinparam classFontName Arial
skinparam classHeaderFontSize 11
skinparam classHeaderFontStyle bold
skinparam arrowColor #000000
skinparam arrowFontSize 9
skinparam nodesep 25
skinparam ranksep 35
skinparam padding 4
skinparam defaultTextAlignment left
skinparam shadowing false

skinparam class {
  BackgroundColor        #e1e1e1
  BorderColor            #000000
  HeaderBackgroundColor  #e1e1e1
  FontColor              #000000
  AttributeFontColor     #000000
}

' ─── CLIENTE ───
class Cliente {
  nit_ci : String
  nombre : String
  apellido_paterno : String
  apellido_materno : String
  rol_contacto : String
  tipo_contratante : String
  telefono : String
  correo : Email
  direccion : String
  nombre_entidad : String
}

' ─── PROYECTO ───
class Proyecto {
  codigo : String
  nombre : String
  descripcion : Text
  tipo_proyecto : String
  estado_proyecto : String
  monto_total : Decimal
  / estado_pago : String
  fecha_inicio : Date
  fecha_fin : Date
  observacion : Text
}

' ─── CONTRATO PROYECTO ───
class ContratoProyecto {
  fecha_firma : Date
  fecha_inicio : Date
  fecha_fin : Date
  monto_acordado : Decimal
  porcentaje_multa_diaria : Decimal
  porcentaje_multa_maxima : Decimal
  garantia_meses : Integer
  observaciones : Text
  documento : File
  / dias_retraso : Integer
  / multa_acumulada : Decimal
  / estado_multa : String
}

' ─── ASIGNACION ───
class AsignacionProyecto {
  fecha_inicio_plan : Date
  fecha_fin_plan : Date
  dias_planificados : Integer
  / dias_reales : Decimal
  / eficiencia_pct : Decimal
  / estado_asignacion : String
  / pct_avance : Decimal
}

' ─── PAGO PROYECTO ───
class PagoProyecto {
  monto : Decimal
  descuento : Decimal
  motivo_descuento : Text
  fecha : Date
  tipo_pago : String
  numero_referencia : String
  estado : String
  / monto_neto : Decimal
}

' ─── HISTORIAL PRESUPUESTO ───
class HistorialPresupuesto {
  monto_anterior : Decimal
  monto_actual : Decimal
  motivo_cambio : Text
  fecha : DateTime
}

' ─── HISTORIAL ESTADO PROYECTO ───
class HistorialEstadoProyecto {
  estado_anterior : String
  estado_nuevo : String
  motivo : Text
  fecha : DateTime
}

' ─── SEDE ───
class Sede {
  nombre : String
  direccion : String
  descripcion : Text
  estado : String
  latitud : Decimal
  longitud : Decimal
  / porcentaje_checklist : Decimal
}

' ─── FOTO SEDE ───
class FotoSede {
  foto : Image
  descripcion : String
}

' ─── TAREA CHECKLIST ───
class TareaChecklist {
  descripcion : String
  orden : Integer
  completado : Boolean
  fecha_completado : DateTime
}

' ─── SUBTAREA ───
class SubtareaChecklist {
  descripcion : String
  orden : Integer
  completado : Boolean
  fecha_completado : DateTime
}

' ─── PLANTILLA ───
class PlantillaTarea {
  nombre : String
  tipo : String
  descripcion : Text
}

class ItemPlantilla {
  descripcion : String
  orden : Integer
}

class SubItemPlantilla {
  descripcion : String
  orden : Integer
}

' ─── GARANTIA ───
class Garantia {
  fecha_inicio : Date
  fecha_vencimiento : Date
  / estado : String
  / dias_restantes : Integer
  / costo_total_incidencias : Decimal
}

class IncidenciaGarantia {
  descripcion : Text
  fecha_reporte : Date
  fecha_reparacion : Date
  costo_reparacion : Decimal
  estado : String
  evidencia : File
}

' ─── NOTIFICACION ───
class Notificacion {
  tipo : String
  mensaje : Text
  leida : Boolean
  fecha : DateTime
}

' ─── EMPLEADO (referencia) ───
class Empleado <<ref>> {
  nombre : String
  cargo : String
}

' ═══════ RELACIONES ═══════
Cliente              "1"     --  "0..*" Proyecto                  : contrata
Proyecto             "1"     --  "0..*" ContratoProyecto          : formaliza
Proyecto             "1"     --  "0..*" Sede                      : tiene
Proyecto             "1"     --  "0..*" PagoProyecto              : recibe
Proyecto             "1"     --  "0..*" HistorialPresupuesto      : registra
Proyecto             "1"     --  "0..*" HistorialEstadoProyecto   : rastrea
Proyecto             "1"     --  "0..*" AsignacionProyecto        : planifica
Proyecto             "0..*"  --  "0..*" Empleado                  : equipo
AsignacionProyecto   "0..*"  --  "1"   Empleado                   : asignado a

ContratoProyecto     "1"     --  "0..1" Garantia                  : genera
Garantia             "1"     --  "0..*" IncidenciaGarantia        : registra
IncidenciaGarantia   "0..*"  --  "0..1" Empleado                  : reparado por

Sede                 "0..*"  --  "0..1" PlantillaTarea            : aplica
Sede                 "1"     --  "0..*" TareaChecklist            : lista
Sede                 "1"     --  "0..*" FotoSede                  : documenta
TareaChecklist       "1"     --  "0..*" SubtareaChecklist         : subdivide
TareaChecklist       "0..*"  --  "0..*" Empleado                  : participantes

PlantillaTarea       "1"     --  "0..*" ItemPlantilla             : contiene
ItemPlantilla        "1"     --  "0..*" SubItemPlantilla          : detalla

Notificacion         "0..*"  --  "1"   Empleado                   : destino
Notificacion         "0..*"  --  "0..1" Proyecto                  : sobre
Notificacion         "0..*"  --  "0..1" Sede                      : sobre

note "/ atributo derivado (calculado)" as N1

@enduml
