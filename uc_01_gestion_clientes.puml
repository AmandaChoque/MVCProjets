@startuml uc_01_gestion_clientes
title Casos de Uso — Gestión de Clientes\nSistema SOBOTEC S.R.L.

left to right direction

skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam backgroundColor #FFFFFF
skinparam usecaseBackgroundColor #F5F5F5
skinparam usecaseBorderColor #777777
skinparam usecaseFontSize 12
skinparam actorFontSize 12
skinparam packageBorderColor #777777
skinparam packageBackgroundColor #FFFFFF
skinparam packageFontStyle bold
skinparam arrowColor #444444
skinparam noteBackgroundColor #FFFFCC
skinparam noteBorderColor #CCAA00

' ── ACTORES ──────────────────────────────────────
actor "Administrador\n/ Gerente" as ADM #F5F5F5
actor "Secretaria"               as SEC #F5F5F5

' ── BOUNDARY ─────────────────────────────────────
rectangle "Sistema SOBOTEC — Gestión de Clientes" {
    usecase "Registrar cliente"  as UC1
    usecase "Editar cliente"     as UC2
    usecase "Desactivar cliente" as UC3
    usecase "Consultar clientes" as UC4
}

' ── ASOCIACIONES ─────────────────────────────────
ADM --> UC1
ADM --> UC2
ADM --> UC3
ADM --> UC4

SEC --> UC1
SEC --> UC2
SEC --> UC4

note right of UC3
  Solo Administrador / Gerente
  puede desactivar un cliente.
end note

@enduml
