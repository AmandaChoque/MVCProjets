    %% =========================================================
    %% ADMINISTRADOR / GERENTE — acceso completo
    %% =========================================================
    ADM --> UC_CL1 & UC_CL2 & UC_CL3 & UC_CL4
    ADM --> UC_PR1 & UC_PR2 & UC_PR3 & UC_PR4 & UC_PR5 & UC_PR6 & UC_PR7 & UC_PR8 & UC_PR9
    ADM --> UC_EQ1 & UC_EQ2 & UC_EQ3 & UC_EQ4
    ADM --> UC_SE1 & UC_SE2 & UC_SE3 & UC_SE4 & UC_SE5 & UC_SE6 & UC_SE7 & UC_SE8
    ADM --> UC_CP1 & UC_CP2 & UC_PG1 & UC_PG2 & UC_PG3 & UC_PG4
    ADM --> UC_PT1 & UC_PT2
    ADM --> UC_GA1 & UC_GA2 & UC_GA3
    ADM --> UC_NT1 & UC_NT2

    %% =========================================================
    %% SECRETARIA — gestión administrativa (sin operaciones críticas)
    %% =========================================================
    SEC --> UC_CL1 & UC_CL2 & UC_CL4
    SEC --> UC_PR1 & UC_PR5 & UC_PR7 & UC_PR8
    SEC --> UC_CP1 & UC_CP2 & UC_PG1 & UC_PG2 & UC_PG4
    SEC --> UC_GA1 & UC_GA2 & UC_GA3
    SEC --> UC_NT1 & UC_NT2

    %% =========================================================
    %% INSTALADOR / TÉCNICO DE SOPORTE — trabajo en campo
    %% =========================================================
    CAMPO --> UC_PR5 & UC_PR9
    CAMPO --> UC_SE5 & UC_SE6 & UC_SE7 & UC_SE8
    CAMPO --> UC_NT1 & UC_NT2

    %% =========================================================
    %% SISTEMA — procesos automáticos (señales Django)
    %% =========================================================
    SIS --> SA1 & SA2 & SA3 & SA4 & SA5

    %% =========================================================
    %% RELACIONES «include» y «extend»
    %% =========================================================
    %% Completar proyecto siempre dispara historial y (si hay contrato) garantía
    UC_PR3 -. «include» .-> SA3
    UC_PR3 -. «extend» .-> SA1

    %% Editar proyecto dispara historial solo si cambia estado o monto
    UC_PR2 -. «extend» .-> SA3

    %% Toda modificación de pago recalcula estado_pago del proyecto
    UC_PG1 -. «include» .-> SA2
    UC_PG2 -. «include» .-> SA2

    %% Crear sede con plantilla seleccionada copia los ítems
    UC_SE1 -. «extend» .-> SA5

    %% Completar la última tarea dispara notificación si sede queda al 100%
    UC_SE5 -. «extend» .-> SA4
