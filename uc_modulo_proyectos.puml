@startuml uc_modulo_proyectos

left to right direction

skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam shadowing false

skinparam backgroundColor #FFFFFF
skinparam usecaseBackgroundColor #EBF5FB
skinparam usecaseBorderColor #2E86C1

skinparam usecaseFontSize 10
skinparam actorFontSize 11
skinparam packageFontSize 11

skinparam packageBorderColor #2E86C1
skinparam packageBackgroundColor #FFFFFF
skinparam packageFontStyle bold

skinparam arrowColor #444444

skinparam nodesep 25
skinparam ranksep 55

'══════════════════════════════════════
' ACTORES IZQUIERDA
'══════════════════════════════════════

actor "Administrador\n/ Gerente" as ADM
actor "Secretaria" as SEC
actor "Instalador /\nTécnico" as CAMPO

rectangle "Sprint 1 — Módulo de Proyectos" {

    '══════════════════════════════════
    ' CASOS PRINCIPALES
    '══════════════════════════════════

    together {

        

        usecase "Gestionar\nProyecto" as UC2

        usecase "Gestionar Sedes\ne Instalación" as UC3

        usecase "Pagos\ndel Proyecto" as UC4

        usecase "Gestionar\nGarantías" as UC5

        usecase "Generar\nReporte" as UC6

        usecase "Gestionar\nPlantillas" as UC7

        usecase "Notificaciones" as UC8

        usecase "Seguimiento y\nPlanificación" as UC9
    }


    '══════════════════════════════════
    ' SUBCASOS PROYECTO
    '══════════════════════════════════

    together {

        usecase "Crear /\nEditar Proyecto" as S3

        usecase "Asignar Equipo\ny Cronograma" as S4

        usecase "Gestionar Contrato\nde Proyecto" as S5
    }

    '══════════════════════════════════
    ' SUBCASOS SEDES
    '══════════════════════════════════

    together {

        usecase "Checklist de\nTareas" as S6

        usecase "Subir Fotos\nde Sede" as S7

        usecase "Aplicar Plantilla\nde Tareas" as S8
    }

    '══════════════════════════════════
    ' SUBCASOS PAGOS
    '══════════════════════════════════

    together {

        usecase "Registrar /\nConfirmar Pago" as S9

 
    }

    '══════════════════════════════════
    ' SUBCASOS GARANTÍAS
    '══════════════════════════════════

    together {

        usecase "Ver Garantías\nVigentes" as S11

        usecase "Registrar\nIncidencia" as S12
    }

    '══════════════════════════════════
    ' SUBCASOS REPORTES
    '══════════════════════════════════

    together {

        usecase "Reporte PDF /\nExcel" as S13

        usecase "Análisis\nFinanciero" as S14
    }

    '══════════════════════════════════
    ' SUBCASOS PLANTILLAS
    '══════════════════════════════════

    together {

        usecase "Crear /\nEditar Plantilla" as S15

        usecase "Gestionar Ítems\ny Subítems" as S16
    }

    '══════════════════════════════════
    ' SUBCASOS NOTIFICACIONES
    '══════════════════════════════════

    together {

        usecase "Ver /\nMarcar Leídas" as S17
    }

    '══════════════════════════════════
    ' SUBCASOS PLANIFICACIÓN
    '══════════════════════════════════

    together {

        usecase "Seguimiento\nde Avance" as S18

        usecase "Diagrama\nGantt" as S19

        usecase "Calendario\nde Equipo" as S20
    }

    '══════════════════════════════════
    ' AUTOMÁTICOS / EXTEND
    '══════════════════════════════════

    together {

        usecase "Crear / Ver\nContrato" as S21

        usecase "Multa Automática\npor Retraso" as S22

        usecase "Crear Garantía\nAutomática" as S23

        usecase "Notificar Sede\nCompletada" as S24
    }

    '══════════════════════════════════
    ' ORDEN VISUAL
    '══════════════════════════════════

    S5  -[hidden]-> S6
    S8  -[hidden]-> S9
    S12 -[hidden]-> S13
    S14 -[hidden]-> S15
    S16 -[hidden]-> S17
    S17 -[hidden]-> S18

    S5  -[hidden]-> S21
    S22 -[hidden]-> S23
    S23 -[hidden]-> S24
}

'══════════════════════════════════════
' ACTOR DERECHA
'══════════════════════════════════════

actor "Sistema\n(Automático)" as SIS

'══════════════════════════════════════
' RELACIONES ACTORES
'══════════════════════════════════════

ADM --> UC2
ADM --> UC3
ADM --> UC4
ADM --> UC5
ADM --> UC6
ADM --> UC7
ADM --> UC8
ADM --> UC9

SEC --> UC2
SEC --> UC4
SEC --> UC5
SEC --> UC6
SEC --> UC8

CAMPO --> UC3
CAMPO --> UC8
CAMPO --> UC9

SIS --> S22
SIS --> S23
SIS --> S24

'══════════════════════════════════════
' INCLUDE
'══════════════════════════════════════


UC2 .> S3  : <<include>>
UC2 .> S4  : <<include>>
UC2 .> S5  : <<include>>

UC3 .> S6  : <<include>>
UC3 .> S7  : <<include>>
UC3 .> S8  : <<include>>

UC4 .> S9  : <<include>>

UC5 .> S11 : <<include>>
UC5 .> S12 : <<include>>

UC6 .> S13 : <<include>>
UC6 .> S14 : <<include>>

UC7 .> S15 : <<include>>
UC7 .> S16 : <<include>>

UC8 .> S17 : <<include>>

UC9 .> S18 : <<include>>
UC9 .> S19 : <<include>>
UC9 .> S20 : <<include>>

'══════════════════════════════════════
' EXTEND / AUTOMÁTICOS
'══════════════════════════════════════

S5  .> S21 : <<include>>

S5  .> S22 : <<extend>>

UC2 .> S23 : <<extend>>

S6  .> S24 : <<extend>>

note right of S22
  Genera multa automática
  según retraso del cronograma
end note

note right of S23
  La garantía se genera
  automáticamente al finalizar
  la instalación
end note

@enduml