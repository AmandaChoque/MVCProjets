@startuml uc_09_notificaciones
title Casos de Uso — Notificaciones\nSistema SOBOTEC S.R.L.

left to right direction

skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam backgroundColor #FFFFFF
skinparam usecaseBackgroundColor #F5F5F5
skinparam usecaseBorderColor #777777
skinparam usecaseFontSize 12
skinparam actorFontSize 12
skinparam packageBorderColor #777777
skinparam packageBackgroundColor #FFFFFF
skinparam packageFontStyle bold
skinparam arrowColor #444444
skinparam noteBackgroundColor #FFFFCC
skinparam noteBorderColor #CCAA00

' ── ACTORES ──────────────────────────────────────
actor "Administrador\n/ Gerente"         as ADM   #F5F5F5
actor "Secretaria"                       as SEC   #F5F5F5
actor "Instalador\n/ Técnico de Soporte" as CAMPO #F5F5F5
actor "Sistema\n(automático)"            as SIS   #F5F5F5

' ── BOUNDARY ─────────────────────────────────────
rectangle "Sistema SOBOTEC — Notificaciones" {

    usecase "Ver notificaciones"        as UC1
    usecase "Marcar como leída"         as UC2
    usecase "Marcar todas como leídas"  as UC3

    usecase "Enviar notificación al\ncompletar sede / tarea" as SA1
}

' ── ASOCIACIONES ─────────────────────────────────
ADM   --> UC1
ADM   --> UC2
ADM   --> UC3

SEC   --> UC1
SEC   --> UC2
SEC   --> UC3

CAMPO --> UC1
CAMPO --> UC2
CAMPO --> UC3

SIS --> SA1

' ── INCLUDE / EXTEND ─────────────────────────────
SA1 .> UC1 : <<include>>

note right of SA1
  El sistema genera notificaciones
  automáticamente cuando una sede
  o tarea llega al 100%.
  Solo Administrador / Gerente
  las reciben como destinatarios.
end note

@enduml
