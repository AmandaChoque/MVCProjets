classDiagram
    direction TB
    %% MODELO DE CONTENIDO COMPLETO - UWE
    %% Proyecto MVCProjets: Gestión Proyectos Seguridad/Instalaciones

    %% BASE
    class AuditModel {
        +created : DateTime
        +updated_at : DateTime
        +deleted_at : DateTime
        +deleted_by : User
        +activo : Boolean
    }

    %% PROYECTOS
    class Cliente {
        +nit_ci : String
        +nombre : String
        +apellido_paterno : String
        +apellido_materno : String
        +rol_contacto : Enum
        +tipo_contratante : Enum
        +telefono : String
        +correo : Email
        +direccion : String
    }

    class Proyecto {
        +codigo : String
        +nombre : String
        +descripcion : Text
        +estado_proyecto : Enum
        +tipo_proyecto : Enum
        +estado_pago : Enum
        +monto_total : Decimal
        +fecha_inicio : Date
        +fecha_fin : Date
    }

    class ContratoProyecto {
        +fecha_firma : Date
        +fecha_inicio : Date
        +fecha_fin : Date
        +monto_acordado : Decimal
        +porcentaje_multa_diaria : Decimal
        +porcentaje_multa_maxima : Decimal
        +garantia_meses : Integer
        +observaciones : Text
        +documento : File
    }

    class PagoProyecto {
        +monto : Decimal
        +descuento : Decimal
        +motivo_descuento : String
        +fecha : Date
        +tipo_pago : Enum
        +numero_referencia : String
        +estado : Enum
    }

    class Sede {
        +nombre : String
        +direccion : String
        +lat : Decimal
        +lng : Decimal
        +estado : Enum
        +porcentaje_checklist : Integer
    }

    class TareaChecklist {
        +descripcion : String
        +orden : Integer
        +completado : Boolean
        +fecha_completado : DateTime
    }

    class FotoSede {
        +foto : Image
        +descripcion : String
    }

    class PlantillaTarea {
        +nombre : String
        +tipo : Enum
    }

    class ItemPlantilla {
        +descripcion : String
        +orden : Integer
    }

    class SubtareaChecklist {
        +descripcion : String
        +completado : Boolean
    }

    class Notificacion {
        +tipo : Enum
        +mensaje : Text
        +leida : Boolean
    }

    %% EMPLEADOS
    class Empleado {
        +nombre : String
        +apellido_paterno : String
        +apellido_materno : String
        +cargo : Enum
        +carnet_identidad : String
        +numero_celular : String
    }
    note for Empleado "extends AbstractUser"

    class ContratoEmpleado {
        +tipo_contrato : Enum
        +dias_laborales : Integer
        +fecha_firma : Date
        +fecha_inicio : Date
        +fecha_fin : Date
        +monto_acordado : Decimal
        +documento : File
    }

    class PagoEmpleado {
        +monto : Decimal
        +fecha : Date
        +tipo_pago : Enum
        +concepto : Enum
        +estado : Enum
    }

    class JornadaEmpleado {
        +fecha : Date
        +dias : Decimal
        +estado : Enum
        +observacion : Text
    }

    class AsignacionProyecto {
        +fecha_inicio_plan : Date
        +fecha_fin_plan : Date
        +dias_planificados : Integer
    }

    %% INVENTARIO
    class Proveedor {
        +nombre : String
        +rubro : Enum
        +nit : String
        +telefono : String
        +encargado_nombre : String
    }

    class Insumo {
        +nombre : String
        +marca : String
        +categoria : Enum
        +unidad_medida : Enum
        +stock : Integer
        +stock_minimo : Integer
        +ultimo_precio_compra : Decimal
    }

    class Requiere {
        +cantidad : Integer
        +durante_garantia : Boolean
    }

    class Compra {
        +cantidad : Integer
        +costo_unitario : Decimal
        +fecha : Date
        +numero_factura : String
    }

    class RequiereLote {
        +cantidad : Integer
    }

    %% GARANTÍAS
    class Garantia {
        +fecha_inicio : Date
        +fecha_vencimiento : Date
        +estado : Enum
        +dias_restantes : Integer
    }

    class IncidenciaGarantia {
        +descripcion : Text
        +fecha_reporte : Date
        +costo_reparacion : Decimal
        +estado : Enum
    }

    class HistorialEstadoProyecto {
        +estado_anterior : Enum
        +estado_nuevo : Enum
        +motivo : Text
    }

    class HistorialPresupuesto {
        +monto_anterior : Decimal
        +monto_actual : Decimal
    }

    %% RELACIONES PRINCIPALES
    Cliente "1" --> "0..*" Proyecto
    Proyecto ||--o| ContratoProyecto : "1..1"
    Proyecto ||--o{ PagoProyecto
    Proyecto ||--o{ Sede
    Sede ||--o{ TareaChecklist
    Sede ||--o{ FotoSede
    TareaChecklist }o--o{ Empleado : "participantes"
    PlantillaTarea ||--o{ ItemPlantilla
    ItemPlantilla ||--o{ SubtareaChecklist

    Empleado ||--o{ ContratoEmpleado
    Proyecto }o--o{ Empleado : "equipo"
    ContratoEmpleado ||--o{ JornadaEmpleado
    JornadaEmpleado }|--|| Proyecto
    ContratoEmpleado ||--o{ PagoEmpleado
    JornadaEmpleado }o--o| PagoEmpleado : "cubierta_por"

    Proveedor ||--o{ Compra
    Insumo ||--o{ Compra
    Proyecto ||--o{ Requiere
    Insumo ||--o{ Requiere
    Requiere ||--o{ RequiereLote
    Compra ||--o{ RequiereLote

    ContratoProyecto ||--|| Garantia : "1..1"
    Garantia ||--o{ IncidenciaGarantia

    Proyecto ||--o{ HistorialEstadoProyecto
    Proyecto ||--o{ HistorialPresupuesto

    Notificacion }|--|| Empleado : "destinatario"
    Notificacion }o--o| Proyecto

    %% HERENCIA
    AuditModel <|-- Proyecto
    AuditModel <|-- Cliente
    AuditModel <|-- Sede
    AuditModel <|-- Empleado
    AuditModel <|-- ContratoEmpleado
    AuditModel <|-- PagoEmpleado
    AuditModel <|-- JornadaEmpleado
    AuditModel <|-- Proveedor
    AuditModel <|-- Insumo
    AuditModel <|-- Requiere
    AuditModel <|-- Compra
    AuditModel <|-- Garantia

