@startuml uc_04_equipo_proyecto
title Casos de Uso — Equipo del Proyecto\nSistema SOBOTEC S.R.L.

left to right direction

skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam backgroundColor #FFFFFF
skinparam usecaseBackgroundColor #F5F5F5
skinparam usecaseBorderColor #777777
skinparam usecaseFontSize 12
skinparam actorFontSize 12
skinparam packageBorderColor #777777
skinparam packageBackgroundColor #FFFFFF
skinparam packageFontStyle bold
skinparam arrowColor #444444
skinparam noteBackgroundColor #FFFFCC
skinparam noteBorderColor #CCAA00

' ── ACTORES ──────────────────────────────────────
actor "Administrador\n/ Gerente"         as ADM   #F5F5F5
actor "Instalador\n/ Técnico de Soporte" as CAMPO #F5F5F5

' ── BOUNDARY ─────────────────────────────────────
rectangle "Sistema SOBOTEC — Equipo del Proyecto" {

    usecase "Agregar empleado al equipo"     as UC1
    usecase "Remover empleado del equipo"    as UC2
    usecase "Editar cronograma por empleado" as UC3
    usecase "Ver planificación Gantt"        as UC4
    usecase "Ver calendario de equipo"       as UC5
}

' ── ASOCIACIONES: Administrador / Gerente ────────
ADM --> UC1
ADM --> UC2
ADM --> UC3
ADM --> UC4
ADM --> UC5

' ── ASOCIACIONES: Instalador / Técnico ───────────
CAMPO --> UC5

note right of UC3
  Registra AsignacionProyecto:
  fecha_inicio_plan, fecha_fin_plan
  y dias_planificados del empleado
  dentro del proyecto.
end note

note right of UC4
  Solo Administrador / Gerente
  puede ver el diagrama Gantt.
end note

note right of UC5
  El calendario de equipo es
  visible para todos los roles.
end note

@enduml
