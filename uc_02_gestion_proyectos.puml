@startuml uc_02_gestion_proyectos
title Casos de Uso — Gestión de Proyectos\nSistema SOBOTEC S.R.L.

left to right direction

skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam backgroundColor #FFFFFF
skinparam usecaseBackgroundColor #F5F5F5
skinparam usecaseBorderColor #777777
skinparam usecaseFontSize 12
skinparam actorFontSize 12
skinparam packageBorderColor #777777
skinparam packageBackgroundColor #FFFFFF
skinparam packageFontStyle bold
skinparam arrowColor #444444
skinparam noteBackgroundColor #FFFFCC
skinparam noteBorderColor #CCAA00

' ── ACTORES ──────────────────────────────────────
actor "Administrador\n/ Gerente" as ADM #F5F5F5
actor "Secretaria"               as SEC #F5F5F5
actor "Sistema\n(automático)"    as SIS #F5F5F5

' ── BOUNDARY ─────────────────────────────────────
rectangle "Sistema SOBOTEC — Gestión de Proyectos" {

    usecase "Crear proyecto"              as UC1
    usecase "Editar proyecto"             as UC2
    usecase "Completar proyecto"          as UC3
    usecase "Desactivar proyecto"         as UC4
    usecase "Eliminar proyecto"           as UC5
    usecase "Ver listado / detalle"       as UC6
    usecase "Ver seguimiento de avance"   as UC7
    usecase "Ver análisis financiero"     as UC8
    usecase "Generar reporte PDF / Excel" as UC9

    usecase "Registrar historial de\nestado / presupuesto" as SA1
}

' ── ASOCIACIONES: Administrador / Gerente ────────
ADM --> UC1
ADM --> UC2
ADM --> UC3
ADM --> UC4
ADM --> UC5
ADM --> UC6
ADM --> UC7
ADM --> UC8
ADM --> UC9

' ── ASOCIACIONES: Secretaria ─────────────────────
SEC --> UC1
SEC --> UC6
SEC --> UC8
SEC --> UC9

' ── ASOCIACIONES: Sistema ────────────────────────
SIS --> SA1

' ── INCLUDE / EXTEND ─────────────────────────────
UC3 .> SA1 : <<include>>
UC2 .> SA1 : <<extend>>

note right of UC7
  Solo Administrador / Gerente
  puede ver el seguimiento.
end note

note right of UC5
  Eliminación permanente
  (hard delete). Solo
  Administrador / Gerente.
end note

note right of SA1
  Se dispara al cambiar
  estado_proyecto o monto_total.
end note

@enduml
