@startuml uc_p4_equipo_plantillas_notif
title Casos de Uso — Parte 4: Equipo, Plantillas y Notificaciones\nSistema SOBOTEC S.R.L.

left to right direction

skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam backgroundColor #FFFFFF
skinparam usecaseBackgroundColor #DDEEFF
skinparam usecaseBorderColor #336699
skinparam usecaseFontSize 12
skinparam actorFontSize 12
skinparam packageBorderColor #777777
skinparam packageBackgroundColor #F5F5F5
skinparam packageFontStyle bold
skinparam arrowColor #444444
skinparam noteBackgroundColor #FFFFCC
skinparam noteBorderColor #CCAA00

' ── ACTORES ──────────────────────────────────────
actor "Administrador\n/ Gerente"         as ADM   #4A90D9
actor "Instalador\n/ Técnico de Soporte" as CAMPO #E67E22

' ── BOUNDARY ─────────────────────────────────────
rectangle "Sistema SOBOTEC — Equipo, Plantillas y Notificaciones" {

    package "Equipo del Proyecto" {
        usecase "Agregar empleado al equipo"     as UC_EQ1
        usecase "Remover empleado del equipo"    as UC_EQ2
        usecase "Editar cronograma por empleado" as UC_EQ3
    }

    package "Planificación" {
        usecase "Ver planificación Gantt"  as UC_EQ4
        usecase "Ver calendario de equipo" as UC_PR9
    }

    package "Plantillas de Tareas" {
        usecase "Crear / Editar plantilla"     as UC_PT1
        usecase "Agregar ítem a la plantilla"  as UC_PT2
        usecase "Agregar subítem al ítem"      as UC_PT3
        usecase "Eliminar ítem / subítem"      as UC_PT4
    }

    package "Notificaciones" {
        usecase "Ver notificaciones"        as UC_NT1
        usecase "Marcar como leída"         as UC_NT2
        usecase "Marcar todas como leídas"  as UC_NT3
    }
}

' ── ASOCIACIONES: Administrador / Gerente ────────
ADM --> UC_EQ1
ADM --> UC_EQ2
ADM --> UC_EQ3
ADM --> UC_EQ4
ADM --> UC_PR9
ADM --> UC_PT1
ADM --> UC_PT2
ADM --> UC_PT3
ADM --> UC_PT4
ADM --> UC_NT1
ADM --> UC_NT2
ADM --> UC_NT3

' ── ASOCIACIONES: Instalador / Técnico ───────────
CAMPO --> UC_PR9
CAMPO --> UC_NT1
CAMPO --> UC_NT2
CAMPO --> UC_NT3

note right of UC_EQ3
  Registra AsignacionProyecto:
  fechas planificadas y días
  asignados al empleado.
end note

note right of UC_EQ4
  Solo Administrador / Gerente
  puede ver el Gantt.
  El calendario es visible
  para todos los roles.
end note

note right of UC_NT1
  Los admins/gerentes reciben
  notificaciones automáticas
  del sistema (sede completada,
  tarea al 100%).
end note

@enduml
