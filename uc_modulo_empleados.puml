@startuml uc_modulo_empleados

left to right direction

skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam backgroundColor #FFFFFF
skinparam usecaseBackgroundColor #EAFAF1
skinparam usecaseBorderColor #333
skinparam usecaseFontSize 11
skinparam actorFontSize 12
skinparam packageBorderColor #444
skinparam packageBackgroundColor #FFFFFF
skinparam packageFontStyle bold
skinparam arrowColor #444444
skinparam nodesep 20
skinparam ranksep 60

' ── ACTORES ──────────────────────────────────────
actor "Administrador\n/ Gerente"         as ADM
actor "Secretaria"                       as SEC
actor "Instalador\n/ Técnico de Soporte" as CAMPO
actor "Sistema\n(automático)"            as SIS

rectangle "Sprint 3 — Módulo de Personal" {

  ' ── COLUMNA 1: UCs principales (mismo rango) ──
  together {
    usecase "Gestionar\nEmpleado"          as UC1
    usecase "Gestionar\nContrato Empleado" as UC2
    usecase "Gestionar\nJornadas"          as UC3
    usecase "Gestionar\nPago Empleado"     as UC4
    usecase "Ver Calendario\nde Jornadas"  as UC5
    usecase "Generar\nReporte"             as UC6
  }

  ' ── COLUMNA 2: sub-casos, un grupo por UC ─────
  together {
    usecase "Registrar /\nEditar empleado" as S1
    usecase "Desactivar /\nReactivar"      as S2
  }
  together {
    usecase "Crear\ncontrato"      as S3
    usecase "Ver PDF\ncontrato"    as S4
    usecase "Desactivar\ncontrato" as S5
  }
  together {
    usecase "Registrar\njornada manual"    as S6
    usecase "Aprobar jornada"  as S7
  
  }
  together {
    usecase "Registrar\npago"              as S10
    usecase "Confirmar /\nDesactivar pago" as S11
  }
  together {
    usecase "Vista mensual\ncon tareas"   as S12
    usecase "Vista semanal\ncon progreso" as S13
    usecase "Vista anual"                 as S14
  }
  together {
    usecase "Reporte PDF\n/ Excel" as S15
  }

  ' flechas ocultas: mantienen el orden vertical entre grupos
  S2  -[hidden]-> S3
  S5  -[hidden]-> S6
  S11 -[hidden]-> S12
  S14 -[hidden]-> S15

  ' ── COLUMNA 3: sub-sub-casos automáticos ──────
  usecase "Jornada auto-creada\nal completar tarea" as S16
  usecase "Dashboard\npersonalizado"                as S17
  usecase "% avance sede\npor día trabajado"        as S18

  S6  -[hidden]-> S16
  S12 -[hidden]-> S17
  S13 -[hidden]-> S18
}

' ── ACTORES → columna 1 ──────────────────────────
ADM   --> UC1
ADM   --> UC2
ADM   --> UC3
ADM   --> UC4
ADM   --> UC5
ADM   --> UC6

SEC   --> UC1
SEC   --> UC2
SEC   --> UC4
SEC   --> UC6

CAMPO --> UC3
CAMPO --> UC5

SIS   --> S16

' ── INCLUDE columna 1 → columna 2 ────────────────
UC1 .> S1  : <<include>>
UC1 .> S2  : <<include>>

UC2 .> S3  : <<include>>
UC2 .> S4  : <<include>>
UC2 .> S5  : <<include>>

UC3 .> S6  : <<include>>
UC3 .> S7  : <<include>>


UC4 .> S10 : <<include>>
UC4 .> S11 : <<include>>

UC5 .> S12 : <<include>>
UC5 .> S13 : <<include>>
UC5 .> S14 : <<include>>

UC6 .> S15 : <<include>>

' ── EXTEND / automáticos ──────────────────────────
UC3   .> S16 : <<extend>>
CAMPO .> S17 : <<extend>>
S13   .> S18 : <<include>>

note right of S16
  El sistema crea la jornada
  al registrar participantes
  de una tarea completada
end note

note right of S18
  Muestra qué tareas realizó
  el empleado cada día y el %
  de avance de la sede en ese momento
end note

@enduml
