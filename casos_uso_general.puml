@startuml casos_uso_general
title Diagrama General de Casos de Uso\nSistema SOBOTEC S.R.L.

left to right direction

skinparam actorStyle hollow
skinparam packageStyle rectangle
skinparam backgroundColor #FFFFFF
skinparam usecaseBackgroundColor #F5F5F5
skinparam usecaseBorderColor #777777
skinparam usecaseFontSize 11
skinparam actorFontSize 13
skinparam actorBorderColor #333333
skinparam packageBorderColor #666666
skinparam packageBackgroundColor #FAFAFA
skinparam packageFontStyle bold
skinparam arrowColor #444444
skinparam noteBackgroundColor #FFFFCC
skinparam noteBorderColor #CCAA00
skinparam nodesep 20
skinparam ranksep 60

' ═══════════════════════════════════════════════
'  ACTORES
' ═══════════════════════════════════════════════
actor "Administrador\n/ Gerente"          as ADM
actor "Secretaria"                        as SEC
actor "Instalador\n/ Técnico de Soporte"  as CAMPO
actor "Sistema\n(automático)"             as SIS

' ═══════════════════════════════════════════════
'  FRONTERA DEL SISTEMA
' ═══════════════════════════════════════════════
rectangle "Sistema SOBOTEC S.R.L." {

    ' ── MÓDULO PROYECTOS ────────────────────────
    package "Módulo Proyectos" as MOD_PR #D6EAF8 {
        usecase "Gestionar Clientes"                 as MP1
        usecase "Gestionar Proyectos\n(crear, editar, completar)" as MP2
        usecase "Gestionar Equipo\ny Cronograma"     as MP3
        usecase "Gestionar Sedes\ne Instalación"     as MP4
        usecase "Contratos y Pagos\ndel Proyecto"    as MP5
        usecase "Gestionar Garantías\nPost-entrega"  as MP6
        usecase "Reportes y Análisis\n(PDF / Excel)" as MP7
        usecase "Notificaciones"                     as MP8
    }

    ' ── MÓDULO EMPLEADOS ────────────────────────
    package "Módulo Empleados" as MOD_EM #D5F5E3 {
        usecase "Gestionar Empleados"                as ME1
        usecase "Gestionar Contratos\nde Empleado"   as ME2
        usecase "Registrar y Aprobar\nJornadas"      as ME3
        usecase "Gestionar Pagos\na Empleados"       as ME4
        usecase "Reportes de\nEmpleados"             as ME5
    }

    ' ── MÓDULO INVENTARIO ───────────────────────
    package "Módulo Inventario" as MOD_IN #FEF9E7 {
        usecase "Gestionar Proveedores"              as MI1
        usecase "Gestionar Insumos\n(stock FIFO)"    as MI2
        usecase "Registrar Compras"                  as MI3
        usecase "Asignar Insumos\na Proyectos"       as MI4
        usecase "Reporte de\nInventario"             as MI5
    }

    ' ── PROCESOS AUTOMÁTICOS ────────────────────
    package "Procesos Automáticos\n(señales Django)" as MOD_AUTO #FFF3CD {
        usecase "Sincronizar estado_pago\ndel proyecto"          as SA1
        usecase "Registrar historial\nestado / presupuesto"      as SA2
        usecase "Crear Garantía al\ncompletar proyecto"          as SA3
        usecase "Notificar admins\nal completar sede"            as SA4
        usecase "Calcular costo\nFIFO automático"               as SA5
        usecase "Fijar fecha_inicio\ndel proyecto"               as SA6
    }

}

' ═══════════════════════════════════════════════
'  ASOCIACIONES — ADMINISTRADOR / GERENTE
'  Accede a la totalidad del sistema
' ═══════════════════════════════════════════════
ADM --> MP1
ADM --> MP2
ADM --> MP3
ADM --> MP4
ADM --> MP5
ADM --> MP6
ADM --> MP7
ADM --> MP8

ADM --> ME1
ADM --> ME2
ADM --> ME3
ADM --> ME4
ADM --> ME5

ADM --> MI1
ADM --> MI2
ADM --> MI3
ADM --> MI4
ADM --> MI5

' ═══════════════════════════════════════════════
'  ASOCIACIONES — SECRETARIA
'  Gestión documental y administrativa;
'  sin acceso a equipo, sedes ni plantillas
' ═══════════════════════════════════════════════
SEC --> MP1
SEC --> MP2
SEC --> MP5
SEC --> MP6
SEC --> MP7
SEC --> MP8

SEC --> ME1
SEC --> ME2
SEC --> ME4
SEC --> ME5

SEC --> MI1
SEC --> MI2
SEC --> MI3
SEC --> MI4
SEC --> MI5

' ═══════════════════════════════════════════════
'  ASOCIACIONES — INSTALADOR / TÉCNICO
'  Trabajo de campo: checklist, fotos, jornadas
' ═══════════════════════════════════════════════
CAMPO --> MP4
CAMPO --> MP8

CAMPO --> ME3

' ═══════════════════════════════════════════════
'  ASOCIACIONES — SISTEMA (automático)
' ═══════════════════════════════════════════════
SIS --> SA1
SIS --> SA2
SIS --> SA3
SIS --> SA4
SIS --> SA5
SIS --> SA6

' ═══════════════════════════════════════════════
'  RELACIONES «include» / «extend»
' ═══════════════════════════════════════════════
MP2 .> SA2 : <<extend>>
MP2 .> SA3 : <<extend>>
MP4 .> SA4 : <<extend>>
MP5 .> SA1 : <<include>>
MI4 .> SA5 : <<include>>
ME3 .> SA6 : <<extend>>

note right of SA3
  Solo si el contrato tiene
  garantia_meses > 0
end note

note right of SA5
  Desencadenado al agregar
  o eliminar Requiere/Compra
end note

note bottom of MOD_AUTO
  Implementados como señales
  Django (pre_save / post_save / delete)
  en models.py de cada app
end note

@enduml
