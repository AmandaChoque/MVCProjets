@startuml uc_06_pagos_cliente
title Casos de Uso — Pagos del Cliente\nSistema SOBOTEC S.R.L.

left to right direction

skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam backgroundColor #FFFFFF
skinparam usecaseBackgroundColor #F5F5F5
skinparam usecaseBorderColor #777777
skinparam usecaseFontSize 12
skinparam actorFontSize 12
skinparam packageBorderColor #777777
skinparam packageBackgroundColor #FFFFFF
skinparam packageFontStyle bold
skinparam arrowColor #444444
skinparam noteBackgroundColor #FFFFCC
skinparam noteBorderColor #CCAA00

' ── ACTORES ──────────────────────────────────────
actor "Administrador\n/ Gerente" as ADM #F5F5F5
actor "Secretaria"               as SEC #F5F5F5
actor "Sistema\n(automático)"    as SIS #F5F5F5

' ── BOUNDARY ─────────────────────────────────────
rectangle "Sistema SOBOTEC — Pagos del Cliente" {

    usecase "Registrar pago de cliente" as UC1
    usecase "Editar pago"               as UC2
    usecase "Confirmar pago"            as UC3
    usecase "Desactivar pago"           as UC4
    usecase "Ver análisis de pagos"     as UC5

    usecase "Sincronizar estado_pago\ndel proyecto" as SA1
}

' ── ASOCIACIONES: Administrador / Gerente ────────
ADM --> UC1
ADM --> UC2
ADM --> UC3
ADM --> UC4
ADM --> UC5

' ── ASOCIACIONES: Secretaria ─────────────────────
SEC --> UC1
SEC --> UC2
SEC --> UC4
SEC --> UC5

' ── ASOCIACIONES: Sistema ────────────────────────
SIS --> SA1

' ── INCLUDE / EXTEND ─────────────────────────────
UC1 .> SA1 : <<include>>
UC2 .> SA1 : <<include>>
UC4 .> SA1 : <<include>>

note right of UC3
  Solo Administrador / Gerente
  puede confirmar un pago.
end note

note right of SA1
  Recalcula estado_pago del proyecto:
  no_pagado / parcial / pagado.
  Se ejecuta tras registrar, editar
  o desactivar cualquier pago.
end note

@enduml
